
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>ByteArcade</title>
<style>
*{box-sizing:border-box}
body{margin:0;background:#080d1c;color:white;font-family:Arial,sans-serif}
header{background:#141d38;padding:18px;text-align:center;border-bottom:2px solid #5eead4}
h1{margin:0;color:#5eead4}
nav{display:flex;justify-content:center;gap:10px;flex-wrap:wrap;padding:15px}
button{background:#536dfe;color:white;border:0;padding:12px 18px;border-radius:8px;cursor:pointer;font-weight:bold}
button:hover{background:#7185ff}
main{max-width:1100px;margin:auto;padding:15px}
.screen{display:none}
.screen.active{display:block}
.card{background:#151f3b;padding:22px;border-radius:14px;margin:12px 0}
canvas{display:block;background:#0c1428;width:100%;max-width:900px;height:500px;margin:auto;border:2px solid #33446e;touch-action:none}
#chat{height:280px;overflow:auto;background:#0b1328;padding:12px;border-radius:8px}
input{padding:12px;border-radius:8px;border:1px solid #43547c;background:#0b1328;color:white}
.chatrow{display:flex;gap:8px;margin-top:10px}
.chatrow input{flex:1}
small{color:#9eacd1}
</style>
</head>
<body>

<header>
<h1>🎮 ByteArcade</h1>
<small>Games and friends in one place</small>
</header>

<nav>
<button onclick="show('home')">Home</button>
<button onclick="show('shooter')">🔫 Shooter</button>
<button onclick="show('blocks')">⛏️ Block World</button>
<button onclick="show('talk')">💬 Talk Room</button>
</nav>

<main>
<section id="home" class="screen active">
<div class="card">
<h2>Welcome to ByteArcade!</h2>
<p>Choose a game and have fun with your friends.</p>
<button onclick="show('shooter')">Play Shooter</button>
<button onclick="show('blocks')">Play Block World</button>
</div>
</section>

<section id="shooter" class="screen">
<div class="card">
<h2>🔫 Neon Shooter</h2>
<p>Move with WASD or arrow keys. Aim with your mouse and click to shoot.</p>
<p id="score">Score: 0 | Health: 5</p>
<button onclick="restartShooter()">Restart</button>
</div>
<canvas id="shoot" width="900" height="500"></canvas>
</section>

<section id="blocks" class="screen">
<div class="card">
<h2>⛏️ Block World</h2>
<p>Move with A and D. Jump with W. Click to break blocks and right-click to place them.</p>
<button onclick="resetWorld()">Reset World</button>
</div>
<canvas id="world" width="900" height="500"></canvas>
</section>

<section id="talk" class="screen">
<div class="card">
<h2>💬 Talk Room</h2>
<p>Enter a name and chat in this browser.</p>
<input id="name" placeholder="Your name">
<div id="chat"></div>
<form class="chatrow" onsubmit="sendMessage(event)">
<input id="message" placeholder="Type a message..." required>
<button>Send</button>
</form>
<small>This demo stores messages only in this open page. Live shared chat needs a server.</small>
</div>
</section>
</main>

<script>
const screens=document.querySelectorAll('.screen');
function show(id){
 screens.forEach(s=>s.classList.toggle('active',s.id===id));
 if(id==='shooter')restartShooter();
 if(id==='blocks')resetWorld();
}

/* CHAT DEMO */
function sendMessage(e){
 e.preventDefault();
 const name=document.getElementById('name').value.trim()||'Player';
 const input=document.getElementById('message');
 const text=input.value.trim();
 if(!text)return;
 const line=document.createElement('p');
 line.textContent=name+': '+text;
 document.getElementById('chat').appendChild(line);
 input.value='';
}

/* SHOOTER */
const sc=document.getElementById('shoot');
const ctx=sc.getContext('2d');
let keys={},shots=[],foes=[],player,points,health,ended,lastSpawn,lastShot;
let mouse={x:450,y:250,down:false};

function restartShooter(){
 player={x:450,y:250,r:17,speed:4};
 shots=[];foes=[];points=0;health=5;ended=false;
 lastSpawn=0;lastShot=0;
}

window.addEventListener('keydown',e=>keys[e.key.toLowerCase()]=true);
window.addEventListener('keyup',e=>keys[e.key.toLowerCase()]=false);

sc.addEventListener('mousemove',e=>{
 const r=sc.getBoundingClientRect();
 mouse.x=(e.clientX-r.left)*900/r.width;
 mouse.y=(e.clientY-r.top)*500/r.height;
});
sc.addEventListener('mousedown',e=>{
 if(e.button===0)mouse.down=true;
});
window.addEventListener('mouseup',e=>{
 if(e.button===0)mouse.down=false;
});

function shooter(t){
 requestAnimationFrame(shooter);
 if(!document.getElementById('shooter').classList.contains('active'))return;
 ctx.clearRect(0,0,900,500);
 ctx.strokeStyle='#172442';
 for(let x=0;x<900;x+=40){
  ctx.beginPath();ctx.moveTo(x,0);ctx.lineTo(x,500);ctx.stroke();
 }
 for(let y=0;y<500;y+=40){
  ctx.beginPath();ctx.moveTo(0,y);ctx.lineTo(900,y);ctx.stroke();
 }

 if(!ended){
  let dx=(keys.d||keys.arrowright?1:0)-(keys.a||keys.arrowleft?1:0);
  let dy=(keys.s||keys.arrowdown?1:0)-(keys.w||keys.arrowup?1:0);
  let len=Math.hypot(dx,dy)||1;
  player.x=Math.max(17,Math.min(883,player.x+dx/len*player.speed));
  player.y=Math.max(17,Math.min(483,player.y+dy/len*player.speed));

  if(mouse.down&&t-lastShot>150){
   lastShot=t;
   let a=Math.atan2(mouse.y-player.y,mouse.x-player.x);
   shots.push({x:player.x,y:player.y,vx:Math.cos(a)*9,vy:Math.sin(a)*9});
  }
  if(t-lastSpawn>800){
   lastSpawn=t;
   let side=Math.floor(Math.random()*4),x,y;
   if(side===0){x=Math.random()*900;y=-20}
   if(side===1){x=920;y=Math.random()*500}
   if(side===2){x=Math.random()*900;y=520}
   if(side===3){x=-20;y=Math.random()*500}
   foes.push({x,y,r:15,s:1+Math.random()});
  }

  shots.forEach(b=>{b.x+=b.vx;b.y+=b.vy});
  shots=shots.filter(b=>b.x>-30&&b.x<930&&b.y>-30&&b.y<530);

  foes.forEach(f=>{
   let a=Math.atan2(player.y-f.y,player.x-f.x);
   f.x+=Math.cos(a)*f.s;f.y+=Math.sin(a)*f.s;
  });

  for(let i=foes.length-1;i>=0;i--){
   let f=foes[i];
   if(Math.hypot(f.x-player.x,f.y-player.y)<f.r+player.r){
    foes.splice(i,1);health--;
    if(health<=0)ended=true;
    continue;
   }
   for(let j=shots.length-1;j>=0;j--){
    if(Math.hypot(f.x-shots[j].x,f.y-shots[j].y)<f.r+5){
     foes.splice(i,1);shots.splice(j,1);points++;break;
    }
   }
  }
 }

 ctx.fillStyle='#ffe66d';
 shots.forEach(b=>{ctx.beginPath();ctx.arc(b.x,b.y,5,0,Math.PI*2);ctx.fill()});
 ctx.fillStyle='#ff5577';
 foes.forEach(f=>{ctx.beginPath();ctx.arc(f.x,f.y,f.r,0,Math.PI*2);ctx.fill()});
 ctx.fillStyle='#5eead4';
 ctx.beginPath();ctx.arc(player.x,player.y,player.r,0,Math.PI*2);ctx.fill();

 document.getElementById('score').textContent='Score: '+points+' | Health: '+health;
 if(ended){
  ctx.fillStyle='white';ctx.font='40px Arial';ctx.textAlign='center';
  ctx.fillText('GAME OVER',450,240);
  ctx.font='18px Arial';ctx.fillText('Press Restart',450,275);
  ctx.textAlign='left';
 }
}
restartShooter();
requestAnimationFrame(shooter);

/* BLOCK WORLD */
const wc=document.getElementById('world');
const wctx=wc.getContext('2d');
const tile=25,cols=36,rows=20;
let map=[],hero,blockKeys={};

function resetWorld(){
 map=Array.from({length:rows},()=>Array(cols).fill(0));
 for(let x=0;x<cols;x++){
  let ground=12+Math.floor(Math.sin(x/3));
  for(let y=ground;y<rows;y++)map[y][x]=y===ground?1:y<ground+3?2:3;
 }
 hero={x:100,y:200,w:18,h:24,vy:0,on:false};
}

function solid(x,y){
 return x<0||x>=cols||y<0||y>=rows||map[y][x]>0;
}
function touching(){
 let l=Math.floor(hero.x/tile),r=Math.floor((hero.x+hero.w)/tile);
 let t=Math.floor(hero.y/tile),b=Math.floor((hero.y+hero.h)/tile);
 for(let y=t;y<=b;y++)for(let x=l;x<=r;x++)if(solid(x,y))return true;
 return false;
}

window.addEventListener('keydown',e=>blockKeys[e.key.toLowerCase()]=true);
window.addEventListener('keyup',e=>blockKeys[e.key.toLowerCase()]=false);
wc.oncontextmenu=e=>e.preventDefault();

wc.addEventListener('mousedown',e=>{
 let r=wc.getBoundingClientRect();
 let x=Math.floor((e.clientX-r.left)/tile);
 let y=Math.floor((e.clientY-r.top)/tile);
 if(x<0||x>=cols||y<0||y>=rows)return;
 if(e.button===0)map[y][x]=0;
 if(e.button===2&&map[y][x]===0)map[y][x]=2;
});

function blocks(){
 requestAnimationFrame(blocks);
 if(!document.getElementById('blocks').classList.contains('active'))return;
 let speed=2.5;
 hero.x+=((blockKeys.d?1:0)-(blockKeys.a?1:0))*speed;
 if(touching()){
  while(touching())hero.x-=Math.sign((blockKeys.d?1:0)-(blockKeys.a?1:0))||1;
 }
 if(blockKeys.w&&hero.on){hero.vy=-8;hero.on=false}
 hero.vy+=.4;hero.y+=hero.vy;hero.on=false;
 if(touching()){
  while(touching())hero.y-=Math.sign(hero.vy)||1;
  if(hero.vy>0)hero.on=true;
  hero.vy=0;
 }
 wctx.fillStyle='#79c9ff';wctx.fillRect(0,0,900,500);
 const colors=['','#4caf50','#8b5a36','#777'];
 for(let y=0;y<rows;y++)for(let x=0;x<cols;x++){
  if(!map[y][x])continue;
  wctx.fillStyle=colors[map[y][x]];
  wctx.fillRect(x*tile,y*tile,tile,tile);
  wctx.strokeStyle='#26364d';wctx.strokeRect(x*tile,y*tile,tile,tile);
 }
 wctx.fillStyle='#303542';wctx.fillRect(hero.x,hero.y,hero.w,hero.h);
}
resetWorld();
requestAnimationFrame(blocks);
</script>
</body>
</html>